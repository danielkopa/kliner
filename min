#!/usr/bin/env bash
#
#   nimo — make your computer feel better.
#   https://github.com/danielkopa/nimo
#
#   min             show nimo
#   min tidy        desktop, dock, wallpaper, preferences — the whole thing
#   min desktop     clear your desktop without losing anything
#   min dock        keep only the apps you actually open
#   min wallpaper   a calmer wallpaper, from the ones macOS ships with
#   min undo        everything nimo has done, and a way back
#   min clean       scan, then free up space (asks first)
#   min preview     same scan, guaranteed to change nothing
#   min top         the biggest folders in your home
#   min doctor      how your computer is doing
#   min setup       a small, sane macOS setup
#   min update      pull the newest nimo
#   min help        this
#
set -u

NIMO_VERSION="0.9.0"

# --- find our own directory, even when called through a symlink ---------
nimo_root() {
    local src="${BASH_SOURCE[0]}" dir
    while [ -h "$src" ]; do
        dir=$(cd -P "$(dirname "$src")" && pwd)
        src=$(readlink "$src")
        case "$src" in
            /*) ;;
            *) src="$dir/$src" ;;
        esac
    done
    cd -P "$(dirname "$src")" && pwd
}

NIMO_ROOT=$(nimo_root)
NIMO_LIB="$NIMO_ROOT/lib"

for _nimo_mod in ui core pick scan clean setup desktop dock wall undo tools; do
    if [ ! -r "$NIMO_LIB/$_nimo_mod.sh" ]; then
        echo "nimo: cannot find $NIMO_LIB/$_nimo_mod.sh" >&2
        echo "nimo: is the whole repository still in one piece?" >&2
        exit 1
    fi
    # shellcheck disable=SC1090
    . "$NIMO_LIB/$_nimo_mod.sh"
done

# --- defaults ------------------------------------------------------------
NIMO_DRY_RUN=0
NIMO_ASSUME_YES=0
NIMO_ONLY=""
NIMO_DAYS=30
NIMO_QUIET=0
NIMO_LIST=0
NIMO_JSON=0
NIMO_UNDO=0
NIMO_RESTORE=0
NIMO_RANDOM=0
NIMO_LIMIT=15
NIMO_COLOR=auto
NIMO_COMMAND=""

nimo_usage() {
    cat <<HELP

  Commands

    min                 say hello
    min tidy            the whole thing: desktop, dock, wallpaper, preferences

    min desktop         clear your desktop, nothing lost
    min dock            keep only the apps you actually open
    min wallpaper       a calmer wallpaper, from the ones macOS ships
    min undo            everything nimo has done, and a way back

    min clean           scan your computer, then free up space
    min preview         the same scan, without touching anything
    min top             the biggest folders in your home
    min doctor          how your computer is doing
    min setup           a small, sane macOS setup
    min update          pull the newest nimo
    min help            show this
    min version         show the version

  Options

    -n, --dry-run       show what would happen, change nothing
    -y, --yes           do not ask for confirmation
        --only a,b      limit to certain items or setup groups
        --days N        what counts as an old download (default 30)
        --undo          put your desktop back the way it was
        --restore       put the dock or the wallpaper back
        --random        let nimo pick the wallpaper
        --list          list the setup groups
        --limit N       how many rows min top shows (default 15)
        --json          machine readable output for clean and preview
        --no-color      plain output
    -q, --quiet         no banner

  Examples

    min tidy
    min desktop
    min desktop --undo
    min dock
    min wallpaper --random
    min undo
    min preview
    min doctor
    min top --limit 20
    min clean --only trash,user-caches
    min clean --days 90
    min preview --json
    min setup --list
    min setup --only dock,finder

HELP
}

nimo_version() {
    printf 'nimo %s\n' "$NIMO_VERSION"
}

# ~/.nimo/config first, so anything typed on the command line still wins
nimo_read_config

# --- argument parsing ----------------------------------------------------
while [ $# -gt 0 ]; do
    case "$1" in
        clean|preview|setup|top|doctor|update|tidy|desktop|dock|wallpaper|undo|help|version)
            [ -z "$NIMO_COMMAND" ] && NIMO_COMMAND="$1"
            ;;
        -n|--dry-run)   NIMO_DRY_RUN=1 ;;
        -y|--yes)       NIMO_ASSUME_YES=1 ;;
        -q|--quiet)     NIMO_QUIET=1 ;;
        --list)         NIMO_LIST=1 ;;
        --json)         NIMO_JSON=1 ;;
        --undo)         NIMO_UNDO=1 ;;
        --restore)      NIMO_RESTORE=1 ;;
        --random)       NIMO_RANDOM=1 ;;
        --limit)
            shift
            if [ $# -eq 0 ]; then
                echo "nimo: --limit needs a number" >&2
                exit 2
            fi
            NIMO_LIMIT="$1"
            ;;
        --limit=*)      NIMO_LIMIT="${1#--limit=}" ;;
        --no-color)     NIMO_COLOR=never ;;
        --color)        NIMO_COLOR=always ;;
        --only)
            shift
            if [ $# -eq 0 ]; then
                echo "nimo: --only needs a value" >&2
                exit 2
            fi
            NIMO_ONLY="$1"
            ;;
        --only=*)       NIMO_ONLY="${1#--only=}" ;;
        --days)
            shift
            if [ $# -eq 0 ]; then
                echo "nimo: --days needs a number" >&2
                exit 2
            fi
            NIMO_DAYS="$1"
            ;;
        --days=*)       NIMO_DAYS="${1#--days=}" ;;
        -h|--help)      NIMO_COMMAND="help" ;;
        -v|--version)   NIMO_COMMAND="version" ;;
        -*)
            echo "nimo: unknown option: $1" >&2
            echo "nimo: try  min help" >&2
            exit 2
            ;;
        *)
            echo "nimo: unknown command: $1" >&2
            echo "nimo: try  min help" >&2
            exit 2
            ;;
    esac
    shift
done

case "$NIMO_DAYS" in
    ''|*[!0-9]*)
        echo "nimo: --days must be a whole number" >&2
        exit 2
        ;;
esac

case "$NIMO_LIMIT" in
    ''|*[!0-9]*|0)
        echo "nimo: --limit must be a positive whole number" >&2
        exit 2
        ;;
esac

nimo_init_colors

# --- dispatch ------------------------------------------------------------

nimo_dispatch() {
    case "$1" in
        tidy)      nimo_cmd_tidy ;;
        desktop)   nimo_cmd_desktop ;;
        dock)      nimo_cmd_dock ;;
        wallpaper) nimo_cmd_wallpaper ;;
        undo)      nimo_cmd_undo ;;
        clean)     nimo_cmd_clean ;;
        preview)   nimo_cmd_preview ;;
        top)       nimo_cmd_top ;;
        doctor)    nimo_cmd_doctor ;;
        setup)     nimo_cmd_setup ;;
        update)    nimo_cmd_update ;;
        version)   nimo_version ;;
        help)      nimo_logo; nimo_usage ;;
    esac
}

if [ -n "$NIMO_COMMAND" ]; then
    nimo_dispatch "$NIMO_COMMAND"
    exit $?
fi

# `min` on its own: a way in if the terminal can do it, the help if it cannot
nimo_logo
if nimo_pick_capable; then
    printf '\n'
    _nimo_choice=$(nimo_menu) || _nimo_choice=""
    if [ -n "$_nimo_choice" ]; then
        nimo_dispatch "$_nimo_choice"
        exit $?
    fi
    printf '\n'
    exit 0
fi

nimo_usage
