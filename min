#!/usr/bin/env bash
#
#   nimo — make your computer feel better.
#   https://github.com/danielkopa/nimo
#
#   min             show nimo
#   min tidy        desktop, dock, wallpaper, preferences — the whole thing
#   min desktop     clear your desktop without losing anything
#   min dock        keep only the apps you actually open
#   min wallpaper   a calmer wallpaper, from the ones macOS ships with
#   min undo        everything nimo has done, and a way back
#   min clean       scan, then free up space (asks first)
#   min preview     same scan, guaranteed to change nothing
#   min top         the biggest folders in your home
#   min doctor      how your computer is doing
#   min setup       a small, sane macOS setup
#   min update      pull the newest nimo
#   min help        this
#
set -u

NIMO_VERSION="0.16.0"

# --- find our own directory, even when called through a symlink ---------
nimo_root() {
    local src="${BASH_SOURCE[0]}" dir
    while [ -h "$src" ]; do
        dir=$(cd -P "$(dirname "$src")" && pwd)
        src=$(readlink "$src")
        case "$src" in
            /*) ;;
            *) src="$dir/$src" ;;
        esac
    done
    cd -P "$(dirname "$src")" && pwd
}

NIMO_ROOT=$(nimo_root)
NIMO_LIB="$NIMO_ROOT/lib"
NIMO_SELF="$NIMO_ROOT/min"

for _nimo_mod in ui core pick repl scan clean setup desktop dock wall look dupes apps undo tools; do
    if [ ! -r "$NIMO_LIB/$_nimo_mod.sh" ]; then
        echo "nimo: cannot find $NIMO_LIB/$_nimo_mod.sh" >&2
        echo "nimo: is the whole repository still in one piece?" >&2
        exit 1
    fi
    # shellcheck disable=SC1090
    . "$NIMO_LIB/$_nimo_mod.sh"
done

# --- defaults ------------------------------------------------------------
NIMO_DRY_RUN=0
NIMO_ASSUME_YES=0
NIMO_ONLY=""
NIMO_DAYS=30
NIMO_QUIET=0
NIMO_LIST=0
NIMO_JSON=0
NIMO_UNDO=0
NIMO_RESTORE=0
NIMO_RANDOM=0
NIMO_MENU=0
NIMO_TARGET=""
NIMO_LIMIT=15
NIMO_COLOR=auto
NIMO_COMMAND=""

nimo_usage() {
    cat <<HELP

  Commands

    min                 a prompt: type /clean desktop, /wallpaper, /undo
    min clear           pick what should be clear: desktop, dock, downloads …
    min clear desktop   or say it outright
    min wallpaper       a calmer one, from the ones macOS ships
    min setup           a small, sane macOS setup
    min undo            put anything back

    min tidy            all of it, one step at a time

    min desktop         clear your desktop, nothing lost
    min downloads       the same, for your downloads
    min screenshots     gather every loose screenshot into one place
    min zen             stop drawing icons on the desktop at all
    min dark            switch appearance — min light switches back
    min hide            let the menu bar slide away
    min duplicates      the same file, kept more than once
    min apps            what you installed once and never opened again
    min empty           take the trash out
    min dock            keep only the apps you actually open

    min clean           scan your computer, then free up space
    min preview         the same scan, without touching anything
    min top             the biggest folders in your home
    min doctor          how your computer is doing
    min setup           a small, sane macOS setup
    min update          pull the newest nimo
    min help            show this
    min version         show the version

  Options

    -n, --dry-run       show what would happen, change nothing
    -y, --yes           do not ask for confirmation
        --only a,b      limit to certain items or setup groups
        --days N        what counts as an old download (default 30)
        --undo          put your desktop back the way it was
        --restore       put the dock, wallpaper or preferences back
        --random        let nimo pick the wallpaper
        --menu          pick from a list with the arrow keys
        --list          list the setup groups
        --limit N       how many rows min top shows (default 15)
        --json          machine readable output for clean and preview
        --no-color      plain output
    -q, --quiet         no banner

  Examples

    min tidy
    min desktop
    min desktop --undo
    min dock
    min wallpaper --random
    min undo
    min preview
    min doctor
    min top --limit 20
    min clean --only trash,user-caches
    min clean --days 90
    min preview --json
    min setup --list
    min setup --only dock,finder
    min setup --restore

HELP
}

nimo_version() {
    printf 'nimo %s\n' "$NIMO_VERSION"
}

# ~/.nimo/config first, so anything typed on the command line still wins
nimo_read_config

# --- argument parsing ----------------------------------------------------
while [ $# -gt 0 ]; do
    case "$1" in
        clear|clean|preview|setup|top|doctor|update|tidy|desktop|downloads|screenshots|zen|dark|light|hide|duplicates|apps|empty|dock|wallpaper|undo|menu|help|version)
            if [ -z "$NIMO_COMMAND" ]; then
                NIMO_COMMAND="$1"
            elif [ -z "$NIMO_TARGET" ]; then
                NIMO_TARGET="$1"
            fi
            ;;
        -n|--dry-run)   NIMO_DRY_RUN=1 ;;
        -y|--yes)       NIMO_ASSUME_YES=1 ;;
        -q|--quiet)     NIMO_QUIET=1 ;;
        --list)         NIMO_LIST=1 ;;
        --json)         NIMO_JSON=1 ;;
        --undo)         NIMO_UNDO=1 ;;
        --restore)      NIMO_RESTORE=1 ;;
        --random)       NIMO_RANDOM=1 ;;
        --menu)         NIMO_MENU=1 ;;
        --limit)
            shift
            if [ $# -eq 0 ]; then
                echo "nimo: --limit needs a number" >&2
                exit 2
            fi
            NIMO_LIMIT="$1"
            ;;
        --limit=*)      NIMO_LIMIT="${1#--limit=}" ;;
        --no-color)     NIMO_COLOR=never ;;
        --color)        NIMO_COLOR=always ;;
        --only)
            shift
            if [ $# -eq 0 ]; then
                echo "nimo: --only needs a value" >&2
                exit 2
            fi
            NIMO_ONLY="$1"
            ;;
        --only=*)       NIMO_ONLY="${1#--only=}" ;;
        --days)
            shift
            if [ $# -eq 0 ]; then
                echo "nimo: --days needs a number" >&2
                exit 2
            fi
            NIMO_DAYS="$1"
            ;;
        --days=*)       NIMO_DAYS="${1#--days=}" ;;
        -h|--help)      NIMO_COMMAND="help" ;;
        -v|--version)   NIMO_COMMAND="version" ;;
        -*)
            echo "nimo: unknown option: $1" >&2
            echo "nimo: try  min help" >&2
            exit 2
            ;;
        *)
            # a second word belongs to the command, as in `min clear desktop`
            if [ -n "$NIMO_COMMAND" ] && [ -z "$NIMO_TARGET" ]; then
                NIMO_TARGET="$1"
            else
                echo "nimo: unknown command: $1" >&2
                echo "nimo: try  min help" >&2
                exit 2
            fi
            ;;
    esac
    shift
done

case "$NIMO_DAYS" in
    ''|*[!0-9]*)
        echo "nimo: --days must be a whole number" >&2
        exit 2
        ;;
esac

case "$NIMO_LIMIT" in
    ''|*[!0-9]*|0)
        echo "nimo: --limit must be a positive whole number" >&2
        exit 2
        ;;
esac

nimo_init_colors

# What the prompt hands down to each command it launches. Without this, a
# session started with --no-color or -y ran its children with neither, and a
# piped -y never reached the confirmation that was waiting for it.
NIMO_INHERIT=""
case "$NIMO_COLOR" in
    never)  NIMO_INHERIT="$NIMO_INHERIT --no-color" ;;
    always) NIMO_INHERIT="$NIMO_INHERIT --color" ;;
esac
[ "$NIMO_QUIET" = "1" ]      && NIMO_INHERIT="$NIMO_INHERIT -q"
[ "$NIMO_ASSUME_YES" = "1" ] && NIMO_INHERIT="$NIMO_INHERIT -y"
[ "$NIMO_DRY_RUN" = "1" ]    && NIMO_INHERIT="$NIMO_INHERIT -n"
[ "$NIMO_DAYS" != "30" ]     && NIMO_INHERIT="$NIMO_INHERIT --days $NIMO_DAYS"
[ "$NIMO_LIMIT" != "15" ]    && NIMO_INHERIT="$NIMO_INHERIT --limit $NIMO_LIMIT"

# --- dispatch ------------------------------------------------------------

nimo_dispatch() {
    case "$1" in
        clear)     nimo_cmd_clear ;;
        tidy)      nimo_cmd_tidy ;;
        desktop)   nimo_cmd_desktop ;;
        downloads) nimo_cmd_downloads ;;
        screenshots) nimo_cmd_screenshots ;;
        zen)       nimo_cmd_zen ;;
        dark)      nimo_cmd_dark ;;
        light)     nimo_cmd_light ;;
        hide)      nimo_cmd_hide ;;
        duplicates) nimo_cmd_duplicates ;;
        apps)      nimo_cmd_apps ;;
        empty)     nimo_cmd_empty ;;
        dock)      nimo_cmd_dock ;;
        wallpaper) nimo_cmd_wallpaper ;;
        undo)      nimo_cmd_undo ;;
        clean)     nimo_cmd_clean ;;
        preview)   nimo_cmd_preview ;;
        top)       nimo_cmd_top ;;
        doctor)    nimo_cmd_doctor ;;
        setup)     nimo_cmd_setup ;;
        update)    nimo_cmd_update ;;
        version)   nimo_version ;;
        menu)      nimo_menu_then_run ;;
        help)      nimo_logo; nimo_usage ;;
    esac
}

if [ -n "$NIMO_COMMAND" ]; then
    nimo_dispatch "$NIMO_COMMAND"
    exit $?
fi

# `min --menu`, and the fallback for `min` on a terminal that cannot prompt
nimo_menu_then_run() {
    nimo_logo
    if ! nimo_pick_capable; then
        nimo_usage
        return 0
    fi
    printf '\n'
    local choice
    choice=$(nimo_menu) || choice=""
    if [ -n "$choice" ]; then
        nimo_dispatch "$choice"
        return $?
    fi
    printf '\n'
    return 0
}

if [ "$NIMO_MENU" = "1" ]; then
    nimo_menu_then_run
    exit $?
fi

# `min` on its own is a prompt. Anywhere it cannot prompt — a pipe, a script,
# a cron job — it prints the help it always did.
if [ -t 0 ] || [ "${NIMO_REPL_FORCE:-0}" = "1" ]; then
    nimo_repl
    exit $?
fi

nimo_logo
nimo_usage
