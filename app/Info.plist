<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Kliner</string>
	<key>CFBundleDisplayName</key>
	<string>Kliner</string>
	<key>CFBundleExecutable</key>
	<string>Kliner</string>
	<key>CFBundleIdentifier</key>
	<string>app.kliner.mac</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__VERSION__</string>
	<key>LSMinimumSystemVersion</key>
	<string>12.0</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- The window is set in Geist, the face kliner.app is set in, which
	     travels inside the app: macOS registers everything in this folder
	     when Kliner launches, so there is nothing to install and nothing to
	     go missing on somebody else's Mac. Poppins is in there too, as the
	     fallback for the weights Geist asks for on its variable axis. Both
	     are under the SIL Open Font License, and both licences travel with
	     them. -->
	<key>ATSApplicationFontsPath</key>
	<string>fonts</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>MIT licensed. https://kliner.app</string>
	<!-- The only thing nimo asks another app to do is open a Terminal window
	     when you choose "Open nimo in Terminal…", and macOS wants that said
	     out loud before it will let it happen. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>Kliner opens a Terminal window when you ask it to, and sets your wallpaper.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Kliner gathers loose screenshots into your Pictures folder.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Kliner sorts your desktop into folders. It never deletes your files.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Kliner sorts your downloads into folders. It never deletes your files.</string>
	<key>NSSupportsSuddenTermination</key>
	<true/>
</dict>
</plist>
